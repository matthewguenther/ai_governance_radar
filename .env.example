# AI Governance Radar — environment configuration
# Copy to `.env` and adjust. Everything has a working default: the app must run
# with NO env file, NO API keys, and NO cloud services (local-first requirement).

# --- Database ---------------------------------------------------------------
# SQLite only in V1 (DECISIONS.md DEC-019). File is created automatically.
DATABASE_URL=sqlite:///./data/radar.db

# --- API server -------------------------------------------------------------
API_HOST=127.0.0.1          # keep localhost unless you know what you're doing (no auth in V1)
API_PORT=8000
CORS_ORIGINS=http://localhost:5173   # dev-only (Vite HMR); production serves SPA + API same-origin (DEC-017)

# --- Ingestion --------------------------------------------------------------
SCHEDULER_ENABLED=false     # true = poll sources in-process; false = run `radar ingest` manually/cron
DEFAULT_POLL_INTERVAL_MINUTES=360
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=2000000     # per-response size cap (SafeFetcher)
USER_AGENT=ai-governance-radar/0.1 (+https://github.com/OWNER/ai-governance-radar)

# --- App --------------------------------------------------------------------
LOG_LEVEL=info
DEMO_DATA=true              # load clearly-marked demo dataset on first run

# --- AI providers (PHASE 2 — not read by V1 code; documented for the future) --
# The app is fully functional without any of these. Never commit real keys.
# LLM_PROVIDER=              # ollama | openrouter | openai_compatible | anthropic
# LLM_BASE_URL=              # e.g. http://localhost:11434 for Ollama
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_MODEL=
